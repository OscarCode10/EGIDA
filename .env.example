# Copiar a .env y cambiar los valores. Todos son FICTICIOS (principio XI: nunca subir .env).
POSTGRES_DB=egida
POSTGRES_USER=egida
POSTGRES_PASSWORD=cambia-esta-clave-postgres

# Clave de firma JWT: mínimo 32 caracteres.
JWT_CLAVE=cambia-esta-clave-jwt-de-al-menos-32-caracteres

# Clave de la API REST de OWASP ZAP (solo red interna).
ZAP_API_KEY=cambia-esta-clave-zap

# Usuarios semilla. Pon correos reales: ahí llegan las alertas.
# Si los dejas vacíos se usan admin@egida.test y cliente@egida.test (no reciben correo).
SEMILLA_ADMIN_CORREO=
SEMILLA_CLIENTE_CORREO=
SEMILLA_ADMIN_CONTRASENA=Admin.Demo.2026
SEMILLA_CLIENTE_CONTRASENA=Cliente.Demo.2026

# URL con la que el navegador abre ÉGIDA (se usa en el enlace del correo).
EGIDA_URL_PUBLICA=http://localhost:5173

# Correo saliente (SMTP real, obligatorio). Las alertas llegan a una bandeja de verdad.
# Por defecto Gmail: smtp.gmail.com, puerto 587, StartTls. SMTP_USUARIO=tu-cuenta@gmail.com y
# SMTP_CONTRASENA=contraseña de aplicación de 16 letras (https://myaccount.google.com/apppasswords,
# requiere verificación en 2 pasos). NUNCA la contraseña normal.
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_SEGURIDAD=StartTls
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_REMITENTE=
